{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "color": {
            "1": "#d71b0c",
            "2": "#b51208"
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "red",
            "title": "#d71b0c",
            "separator": "cyan",
            "output": "#459f38"
        }
    },
    "modules": [
        {
            "type": "custom",
            "key": "﴿  I use Arch btw  ﴾"
        },
        "break",
        "title",
        "separator",
        "os",
        "kernel",
        "host",
        "packages",
        {
            "type": "command",
            "key": "Directory",
            "text": "printf \"%s\" \"$PWD\" | sed \"s|$HOME|~|\"",
            "outputColor": "#a855f7"
        },
        "separator",
        "uptime",
        "display",
        "wm",
        "separator",
        "poweradapter",
        "battery",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "break",
        "colors"
    ]
}